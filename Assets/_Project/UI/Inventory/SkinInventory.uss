.inventory-root { flex-grow: 1; color: rgb(235, 243, 250); font-size: 17px; }
.header { position: absolute; left: 20px; right: 20px; top: 16px; height: 52px; flex-direction: row; justify-content: space-between; align-items: center; background-color: rgb(16, 29, 48); border-radius: 12px; padding-left: 18px; padding-right: 14px; }
#inventory-title { font-size: 23px; -unity-font-style: bold; }
Button { background-color: rgb(40, 61, 82); color: rgb(240, 246, 255); border-width: 1px; border-color: rgb(65, 91, 117); border-radius: 8px; min-height: 34px; }
Button:hover { background-color: rgb(54, 81, 105); }
Button:focus { border-color: rgb(91, 224, 189); }
.browser { position: absolute; left: 20px; top: 84px; bottom: 20px; width: 57%; background-color: rgba(16, 29, 48, 0.97); border-radius: 14px; padding: 16px; }
#section-title { font-size: 24px; -unity-font-style: bold; margin-bottom: 12px; }
.filters { flex-direction: row; align-items: center; margin-bottom: 12px; }
.search { flex-grow: 1; min-width: 80px; margin-left: 8px; margin-right: 12px; }
.skin-scroll { flex-grow: 1; }
.skin-grid { flex-direction: row; flex-wrap: wrap; align-content: flex-start; }
.skin-card { width: 30%; min-width: 125px; height: 182px; margin: 5px; padding: 5px; background-color: rgb(30, 46, 64); border-width: 2px; align-items: center; }
.skin-card Image { width: 100%; height: 105px; }
.skin-card Label { -unity-text-align: middle-center; font-size: 16px; }
.skin-card .rarity { color: rgb(157, 188, 218); font-size: 13px; }
.skin-card #ownership { color: rgb(103, 223, 187); font-size: 12px; margin-top: 3px; }
.skin-card.selected { border-color: rgb(89, 226, 188); background-color: rgb(35, 68, 77); }
#hint { font-size: 13px; color: rgb(167, 189, 209); margin-top: 10px; white-space: normal; }
.details { position: absolute; left: 61%; right: 20px; top: 84px; background-color: rgba(16, 29, 48, 0.96); border-radius: 14px; padding: 16px; }
.selected-title { font-size: 24px; -unity-font-style: bold; margin-right: 110px; white-space: normal; }
.selected-image { position: absolute; right: 16px; top: 10px; width: 100px; height: 100px; }
.description { margin-top: 8px; margin-right: 95px; font-size: 14px; white-space: normal; color: rgb(175, 198, 217); }
.equip { margin-top: 14px; height: 42px; background-color: rgb(39, 143, 113); -unity-font-style: bold; font-size: 19px; }
.equip:disabled { opacity: 0.65; }
.feedback { font-size: 13px; margin-top: 8px; white-space: normal; color: rgb(103, 223, 187); }
.save-error { color: rgb(255, 173, 108); }
.equipped-label { position: absolute; left: 61%; right: 20px; bottom: 22px; padding: 10px; border-radius: 8px; background-color: rgba(16, 29, 48, 0.94); -unity-text-align: middle-center; font-size: 15px; }
#item-category { margin-bottom: 10px; }
#unequip-gear { margin-top: 5px; }
